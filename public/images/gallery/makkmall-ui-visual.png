<svg width="1200" height="800" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#080c16" />
      <stop offset="50%" stop-color="#0f1629" />
      <stop offset="100%" stop-color="#05070e" />
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#6366f1" />
      <stop offset="100%" stop-color="#38bdf8" />
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255, 255, 255, 0.04)" stroke-width="1" />
    </pattern>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="30" result="blur" />
    </filter>
  </defs>

  <!-- Background -->
  <rect width="1200" height="800" fill="url(#bg)" />
  <rect width="1200" height="800" fill="url(#grid)" />

  <!-- Glowing Orbs -->
  <circle cx="200" cy="150" r="180" fill="#6366f1" opacity="0.15" filter="url(#glow)" />
  <circle cx="1000" cy="650" r="220" fill="#38bdf8" opacity="0.1" filter="url(#glow)" />

  <!-- Frame Border -->
  <rect x="30" y="30" width="1140" height="740" rx="16" fill="none" stroke="rgba(255, 255, 255, 0.1)" stroke-width="2" />
  
  <!-- Category Badge -->
  
  <rect x="70" y="70" width="148" height="36" rx="18" fill="rgba(255, 255, 255, 0.06)" stroke="rgba(255, 255, 255, 0.15)" stroke-width="1" />
  <text x="90" y="93" font-family="system-ui, sans-serif" font-size="14" font-weight="600" fill="#6366f1" letter-spacing="1">UI DESIGN</text>
  

  <!-- Center Card UI representation -->
  <rect x="70" y="140" width="1060" height="580" rx="12" fill="rgba(15, 22, 41, 0.6)" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" />

  <!-- Decorative Window Header -->
  <circle cx="110" cy="175" r="6" fill="#ef4444" opacity="0.7" />
  <circle cx="130" cy="175" r="6" fill="#f59e0b" opacity="0.7" />
  <circle cx="150" cy="175" r="6" fill="#10b981" opacity="0.7" />
  <line x1="70" y1="200" x2="1130" y2="200" stroke="rgba(255, 255, 255, 0.06)" stroke-width="1" />

  <!-- Title & Subtitle -->
  <text x="110" y="340" font-family="system-ui, -apple-system, sans-serif" font-size="44" font-weight="800" fill="#f8fafc">MAKKMAL UI Design System</text>
  <text x="110" y="400" font-family="system-ui, -apple-system, sans-serif" font-size="22" font-weight="400" fill="#94a3b8">Dark Mode Components &amp; Authentication Screens</text>

  <!-- Accent Line -->
  <rect x="110" y="440" width="120" height="4" rx="2" fill="url(#accent)" />

  <!-- Abstract Tech Grid Lines inside UI box -->
  <g opacity="0.25">
    <rect x="700" y="240" width="360" height="180" rx="8" fill="none" stroke="#6366f1" stroke-width="2" stroke-dasharray="6,6" />
    <rect x="700" y="450" width="170" height="210" rx="8" fill="rgba(255,255,255,0.04)" />
    <rect x="890" y="450" width="170" height="210" rx="8" fill="rgba(255,255,255,0.04)" />
    <line x1="700" y1="330" x2="1060" y2="330" stroke="#6366f1" stroke-width="2" />
  </g>

  <!-- Watermark -->
  <text x="110" y="660" font-family="system-ui, sans-serif" font-size="16" font-weight="600" fill="#64748b" letter-spacing="2">GALLA JAGADEESH — PORTFOLIO VISUAL</text>
</svg>